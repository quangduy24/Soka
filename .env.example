# ─── Mezo Network Configuration ───────────────────────────────
# Verified against the official Mezo Pools docs (testnet contracts) and
# on-chain code checks. Override via environment when networks change.
MEZO_RPC_ENDPOINT=https://rpc.test.mezo.org
MEZO_WS_RPC=wss://rpc-ws.test.mezo.org
MEZO_CHAIN_ID=31611
MEZO_EXPLORER_URL=https://explorer.test.mezo.org
MEZO_ROUTER_ADDRESS=0x9a1ff7FE3a0F69959A3fBa1F1e5ee18e1A9CD7E9
MEZO_FACTORY_ADDRESS=0x4947243CC818b627A5D06d14C4eCe7398A23Ce1A
# Optional: explicit MUSD token address. Empty = auto-discovered from pool legs.
MEZO_MUSD_ADDRESS=

# ─── Precompiled Contracts ────────────────────────────────────
MEZO_PRECOMPILE_BTC=0x7b7c000000000000000000000000000000000000
MEZO_PRECOMPILE_MEZO=0x7b7c000000000000000000000000000000000001
MEZO_PRECOMPILE_ASSETS_BRIDGE=0x7b7c000000000000000000000000000000000012
MEZO_PRECOMPILE_PRICE_ORACLE=0x7b7c000000000000000000000000000000000015

# ─── LLM & AI Engine (OpenRouter) ─────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash
OPENROUTER_FALLBACK_MODELS=poolside/laguna-s-2.1:free, inclusionai/ling-3.0-flash-fin:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=20000
# Optional overrides (defaults in code): LLM_DEFAULT_TEMP, LLM_DEFAULT_MAX_TOKENS,
# LLM_TEMP_PARSER, LLM_TEMP_ADVISOR, LLM_ADVISOR_SHORT_TOKENS, APP_TITLE, APP_REFERER_URL

# ─── Market Data (all optional; defaults are safe) ──────────────
PRICE_CACHE_TTL_MS=60000
PRICE_MAX_STALENESS_SEC=3600
POOLS_CACHE_TTL_MS=30000
POOLS_MAX_SCAN=50
BRIDGE_INFO_TTL_MS=30000
POOLS_DEFAULT_LIMIT=20
POOLS_MAX_LIMIT=100
TOKEN_SEARCH_LIMIT=5

# ─── Swap / Transaction Building ────────────────────────────────
DEFAULT_SLIPPAGE_PCT=0.5
MAX_SLIPPAGE_PCT=50
TX_DEADLINE_SEC=1200
APPROVE_MULTIPLIER=10
GAS_RESERVE_BTC=0.0005
GAS_ESTIMATE_UNITS=250000
TX_RECEIPT_TIMEOUT_MS=60000
GAS_WARN_GWEI=50
ROUTER_TVL_CAP_USD=10000000

# ─── Bridge ─────────────────────────────────────────────────────
# 0=Ethereum, 1=Bitcoin
BRIDGE_DEFAULT_CHAIN=0
BRIDGE_DEFAULT_CHAINS=0,1
# Empty = block the build when the precompile read fails (no assumed fallback)
BRIDGE_DEFAULT_CAPACITY=
BRIDGE_DEFAULT_MIN_AMOUNT=

# ─── Intent Parsing ─────────────────────────────────────────────
INTENT_VALID_THRESHOLD=0.5
PRICE_IMPACT_PER_HOP=0.05
PRICE_IMPACT_CAP=1.5
LIQUIDITY_DANGER_RATIO=0.5

# ─── Risk Guardian (all optional; operator-tunable) ─────────────
RISK_PRICE_IMPACT_WARN=1.0
RISK_PRICE_IMPACT_SPLIT=3.0
RISK_PRICE_IMPACT_REJECT=5.0
RISK_MIN_LIQUIDITY_STABLE=50000
RISK_MIN_LIQUIDITY_VOLATILE=10000
RISK_MIN_SAFE_SCORE=30
RISK_MAX_HOPS=3

# ─── Lending Risk Parameters (operator-configured) ──────────────
BORROW_MAX_LTV=0.75
BORROW_LIQ_LTV=0.85
BORROW_APR_DEFAULT=
BORROW_APR_MUSD=
BORROW_APR_MUSDC=
# Empty = execution unavailable (quotes are read-only advisories)
LENDING_POOL_ADDRESS=
VAULT_ADDRESS=

# ─── CORS (comma-separated origins; empty = same-origin only) ───
CORS_ORIGIN=

# ─── RPC / Rate limiting / Server (all optional) ────────────────
MEZO_RPC_TIMEOUT_MS=15000
MEZO_RPC_RETRY_COUNT=3
MEZO_RPC_RETRY_DELAY_MS=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_CLEANUP_MS=60000
API_BODY_LIMIT=1mb
HOST=0.0.0.0
LOG_BODY_MAX_LEN=200
ALT_SOURCE_MIN_USD=1
ALT_SOURCE_RATIO=0.1

# ─── Token Addresses (override per-network; defaults are Mezo Testnet) ─
TOKEN_BTC_ADDRESS=0x0000000000000000000000000000000000000000
# wBTC/MEZO default to the precompiles above; stables default to Testnet contracts
#TOKEN_MUSDC_ADDRESS=
#TOKEN_MUSDT_ADDRESS=
#TOKEN_MDAI_ADDRESS=
#TOKEN_MUSDE_ADDRESS=
#TOKEN_MCBBTC_ADDRESS=
#TOKEN_MFBTC_ADDRESS=
#TOKEN_MSOLVBTC_ADDRESS=
#TOKEN_MSWBTC_ADDRESS=
#TOKEN_MT_ADDRESS=

# ─── Extra Precompiles (defaults match Mezo Testnet version map) ──
MEZO_PRECOMPILE_VALIDATOR_POOL=0x7b7c000000000000000000000000000000000011
MEZO_PRECOMPILE_MAINTENANCE=0x7b7c000000000000000000000000000000000013
MEZO_PRECOMPILE_UPGRADE=0x7b7c000000000000000000000000000000000014

# ─── RPC URL alias ────────────────────────────────────────────────
#MEZO_RPC_URL=

# ─── Known pools for MUSD discovery (comma-separated; empty = on-chain scan)
#MEZO_KNOWN_POOLS=

# ─── Risk Guardian fine-tuning (all optional) ─────────────────────
RISK_LIQ_HEALTH_STABLE_DANGER=50000
RISK_LIQ_HEALTH_STABLE_WARN=100000
RISK_LIQ_HEALTH_STABLE_NEUTRAL=200000
RISK_LIQ_HEALTH_VOLATILE_DANGER=10000
RISK_LIQ_HEALTH_VOLATILE_WARN=20000
RISK_LIQ_HEALTH_VOLATILE_NEUTRAL=50000
RISK_POOL_AGE_DANGER_DAYS=7
RISK_POOL_AGE_WARN_DAYS=3
RISK_POOL_MIN_AGE_DAYS=7
RISK_HOLDER_CONC_WARN=50
RISK_HOLDER_CONC_REJECT=80
RISK_LIQ_IMPACT_DANGER=0.20
RISK_LIQ_IMPACT_WARN=0.05
RISK_SUPPLY_CONC_DANGER=0.05
RISK_SUPPLY_CONC_WARN=1.0
RISK_POOL_UTIL_WARN=0.3
RISK_SCORE_DEDUCT_DANGER=25
RISK_SCORE_DEDUCT_WARNING=10
RISK_LEVEL_LOW=80
RISK_LEVEL_MEDIUM=60
RISK_LEVEL_HIGH=30

# ─── Auto-slippage engine params (currently reserved for future use) ─
SLIPPAGE_BASE=0.1
SLIPPAGE_IMPACT_MULT=1.5
SLIPPAGE_LIQ_FACTOR=2.0
SLIPPAGE_HOP_COST=0.15
SLIPPAGE_MIN=0.1
SLIPPAGE_MAX=15

# ─── Intent confidence weights ────────────────────────────────────
INTENT_W_MISSING_TOKEN=0.15
INTENT_W_MISSING_ADDRESS=0.25
INTENT_W_MISSING_AMOUNT=0.2

# ─── LLM defaults ─────────────────────────────────────────────────
LLM_DEFAULT_TEMP=0.2
LLM_DEFAULT_MAX_TOKENS=1024
LLM_TEMP_PARSER=0.1
LLM_TEMP_ADVISOR=0.3
LLM_ADVISOR_SHORT_TOKENS=150
APP_TITLE=Soka Intent Engine
APP_REFERER_URL=https://soka-intent-engine.app

# ─── Frontend ───────────────────────────────────────────────────
# NOTE: Vite reads .env ONCE at dev-server startup — restart `npm run dev`
# after editing this file, then hard-refresh the browser (Ctrl+F5).
# NOTE: frontend code must read env via STATIC `import.meta.env.VITE_X`
# (see src/config.ts). Dynamic `import.meta.env[name]` / `import.meta?.env`
# is left undefined by Vite and once blank-screened the app at boot.
# VITE_API_URL= (empty = same-origin /api)
# VITE_ENABLE_MARKET=false
# Public WalletConnect client ID from https://cloud.walletconnect.com (required, not a secret)
VITE_WALLETCONNECT_PROJECT_ID=c4f79cc821944d9680842e34466bfb
# Optional overrides (built-in defaults target Mezo Testnet):
# VITE_MEZO_CHAIN_ID, VITE_MEZO_RPC_HTTP, VITE_MEZO_RPC_WS, VITE_MEZO_EXPLORER_URL,
# VITE_API_PROXY, VITE_DEFAULT_SOURCE, VITE_DEFAULT_DEST,
# VITE_DEFAULT_AMOUNT, VITE_DEFAULT_SLIPPAGE, VITE_QUICK_PROMPTS (JSON array),
# VITE_HISTORY_LIMIT, VITE_HISTORY_DEDUP_MS, VITE_AUTO_SELECT_DELAY_MS,
# VITE_TX_CONFIRM_TIMEOUT_MS, VITE_POOLS_LIMIT, VITE_POOLS_STALE_MS, VITE_POOLS_RETRY,
# VITE_WALLET_REFRESH_MS, VITE_WALLET_STALE_MS, VITE_MARKET_REFRESH_MS,
# VITE_COPY_RESET_MS, VITE_MAX_ROUTE_NODES, VITE_MAX_CHECKS_SHOWN,
# VITE_MAX_ADVISE_EXAMPLES, VITE_QUOTE_DECIMALS, VITE_MAX_SLIPPAGE_PCT

# ─── Server & Logging ─────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
NODE_ENV=development