# ─── Mezo Network Configuration ───────────────────────────────
# Verified against the official Mezo Pools docs (testnet contracts) and
# on-chain code checks. Override via environment when networks change.
MEZO_RPC_ENDPOINT=https://rpc.test.mezo.org
MEZO_WS_RPC=wss://rpc-ws.test.mezo.org
MEZO_CHAIN_ID=31611
MEZO_EXPLORER_URL=https://explorer.test.mezo.org
MEZO_ROUTER_ADDRESS=0x9a1ff7FE3a0F69959A3fBa1F1e5ee18e1A9CD7E9
MEZO_FACTORY_ADDRESS=0x4947243CC818b627A5D06d14C4eCe7398A23Ce1A
# Optional: explicit MUSD token address. Empty = auto-discovered from pool legs.
MEZO_MUSD_ADDRESS=

# ─── Precompiled Contracts ────────────────────────────────────
MEZO_PRECOMPILE_BTC=0x7b7c000000000000000000000000000000000000
MEZO_PRECOMPILE_MEZO=0x7b7c000000000000000000000000000000000001
MEZO_PRECOMPILE_ASSETS_BRIDGE=0x7b7c000000000000000000000000000000000012
MEZO_PRECOMPILE_PRICE_ORACLE=0x7b7c000000000000000000000000000000000015

# ─── LLM & AI Engine (OpenRouter) ─────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=poolside/laguna-s-2.1:free, inclusionai/ling-3.0-flash-fin:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=20000

# ─── Market Data (all optional; defaults are safe) ──────────────
PRICE_CACHE_TTL_MS=60000
PRICE_MAX_STALENESS_SEC=3600
POOLS_CACHE_TTL_MS=30000
POOLS_MAX_SCAN=50

# ─── Lending Risk Parameters (operator-configured) ──────────────
BORROW_MAX_LTV=0.75
BORROW_LIQ_LTV=0.85
BORROW_APR_DEFAULT=
BORROW_APR_MUSD=
BORROW_APR_MUSDC=
# Empty = execution unavailable (quotes are read-only advisories)
LENDING_POOL_ADDRESS=
VAULT_ADDRESS=

# ─── CORS (comma-separated origins; empty = same-origin only) ───
CORS_ORIGIN=

# ─── Frontend ───────────────────────────────────────────────────
# VITE_API_URL= (empty = same-origin /api)
# VITE_ENABLE_MARKET=false

# ─── Server & Logging ─────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
NODE_ENV=development